# ========================================================
# AegisAI Enterprise Configuration
# ========================================================

# Server Port
PORT=8080

# Google Gemini API Key (Obtain free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Domains for Google Authentication
# Set to '*' to allow any Google Account, or specify comma-separated domains (e.g. yourcompany.com,gmail.com)
VITE_ALLOWED_DOMAINS=*

# Optional LLM Provider: 'gemini' | 'openai' | 'openrouter' | 'custom_openai_compatible'
LLM_PROVIDER=gemini
