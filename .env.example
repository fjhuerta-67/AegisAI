# ========================================================
# AegisAI Enterprise Configuration
# ========================================================

# Server Port
PORT=8080

# Google Gemini API Key (Obtain free at https://aistudio.google.com)
# Not needed when GOOGLE_GENAI_USE_ENTERPRISE=true (Vertex AI through Application Default Credentials).
GEMINI_API_KEY=your_gemini_api_key_here

# Vertex AI / Gemini Enterprise Agent Platform (keyless, uses ADC: `gcloud auth application-default login`
# locally, the Cloud Run runtime service account in production).
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash

# Firestore database used by the server (Admin SDK). Defaults to the firestoreDatabaseId in firebase-applet-config.
# FIRESTORE_DATABASE_ID=aegis-ai-db

# Allowed Domains for Google Authentication (build-time, exact match on the email domain)
# Set to '*' to allow any Google Account, or specify comma-separated domains (e.g. yourcompany.com,gmail.com)
VITE_ALLOWED_DOMAINS=*

# Demo mode button on the login screen (bypasses Google sign-in). Keep 'false' for any shared deployment.
VITE_ENABLE_DEMO_MODE=false

# GCP Live Scanner "ADC" mode scans with the server's own identity. Disabled unless set to 'true'.
# ENABLE_LIVE_SCANNER_ADC=false

# Optional LLM Provider: 'gemini' | 'openai' | 'openrouter' | 'custom_openai_compatible'
LLM_PROVIDER=gemini
