{
  "name": "aegis-ai",
  "version": "2.0.0",
  "description": "Enterprise AI Security, Governance & Verification Platform (OWASP AISVS v1.0, ISO/IEC 42001, GCP Live Scanner)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "dev": "tsx server.ts",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "test:security": "node scripts/run_owasp_ai_security_tests.mjs",
    "test:integration": "node scripts/run_integration_verification_tests.mjs",
    "test:llm": "node scripts/test_llm_providers.mjs",
    "test:gcp": "node scripts/test_gcp_live_scanner.mjs",
    "docs:pdf": "node scripts/generate_all_manuals_pdf.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
