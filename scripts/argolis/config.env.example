# AegisAI deployment settings used by scripts/argolis/*.sh and deploy_cloud_run.sh.
# Copy to scripts/argolis/config.env (gitignored) and adjust.
# Environment variables override these values, e.g.:  ACCESS_MODE=public ./deploy_cloud_run.sh

PROJECT_ID="your-gcp-project-id"
REGION="us-central1"
SERVICE_NAME="aegis-ai"
REPO_NAME="cloud-run-source-deploy"

# Firestore database used by the app (must match firestoreDatabaseId in firebase-applet-config[.local].json).
FIRESTORE_DATABASE_ID="aegis-ai-db"
FIRESTORE_LOCATION="nam5"

# Email domains allowed in (comma-separated, exact match on the part after '@').
# Used for: IAP access (ACCESS_MODE=iap), the app's sign-in allow-list (build-time) and the
# Firestore rules consistency check. firestore.rules must list the same domains.
ALLOWED_DOMAINS="example.com"

# iap    -> Identity-Aware Proxy: only ALLOWED_DOMAINS can reach the service at all (recommended).
# public -> URL reachable by anyone; access is controlled by the app's Google sign-in only.
ACCESS_MODE="iap"

# Gemini through Vertex AI (Application Default Credentials of the runtime service account; no API keys).
GEMINI_MODEL="gemini-3.8-flash"
VERTEX_LOCATION="global"

# Keep both disabled for shared deployments.
ENABLE_DEMO_MODE="false"          # 'true' shows the login-bypass demo button
ENABLE_LIVE_SCANNER_ADC="false"   # 'true' lets the GCP Live Scanner use the service's own identity (grants roles/viewer)

BUILD_SA_NAME="aegis-build-sa"
RUNNER_SA_NAME="aegis-runner-sa"
ADMIN_TOKEN_SECRET="aegis-admin-token"
